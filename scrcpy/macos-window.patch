+#ifndef SC_MACOS_WINDOW_H
+#define SC_MACOS_WINDOW_H
+
+#include "common.h"
+
+#include <SDL3/SDL.h>
+
+// Style a borderless window like QuickTime's iPhone mirror: rounded corners,
+// a shadow, and a title bar with traffic lights over the top of the screen
+// while Cmd is held over the window (and briefly when it opens), so the top
+// edge stays the phone's for pull-downs. Dragging that bar, or Cmd + dragging
+// anywhere, moves the window; with Cmd held, no mouse event reaches the device.
+void
+sc_macos_window_init(SDL_Window *window, const char *title);
+
+// The phone's screen size, so the window keeps its shape: the window fits it
+// exactly (no letterbox) and resizing from the outline keeps it.
+void
+sc_macos_window_set_aspect(SDL_Window *window, int width, int height);
+
+#endif
diff -ruN a/app/src/sys/macos/window.m b/app/src/sys/macos/window.m
--- a/app/src/sys/macos/window.m
+++ b/app/src/sys/macos/window.m
@@ -0,0 +1,830 @@
+#include "sys/macos/window.h"
+
+#import <AppKit/AppKit.h>
+#import <QuartzCore/QuartzCore.h>
+
+#include "util/log.h"
+
+#define SC_TITLE_BAR_HEIGHT 28.0
+// Close to the screen corners of current phones at this window width
+#define SC_CORNER_RADIUS_RATIO 0.09
+#define SC_HOVER_POLL_INTERVAL (1.0 / 30)
+#define SC_FADE_DURATION 0.15
+#define SC_LIGHT_SIZE 12.0
+#define SC_LIGHT_SPACING 8.0
+#define SC_LIGHT_MARGIN 8.0
+
+@interface SCTitleBarView : NSView
+@property(nonatomic, readonly) BOOL dragging;
+@end
+
+@implementation SCTitleBarView {
+    NSPoint drag_start_mouse;
+    NSPoint drag_start_origin;
+}
+
+- (BOOL)acceptsFirstMouse:(NSEvent *)event {
+    (void) event;
+    return YES;
+}
+
+// The bar is chrome you click, so it keeps macOS's arrow, never the touch
+// pointer
+- (void)resetCursorRects {
+    [self addCursorRect:self.bounds cursor:NSCursor.arrowCursor];
+}
+
+- (void)updateTrackingAreas {
+    for (NSTrackingArea *area in self.trackingAreas) {
+        [self removeTrackingArea:area];
+    }
+    [self addTrackingArea:[[NSTrackingArea alloc]
+        initWithRect:self.bounds
+             options:NSTrackingCursorUpdate | NSTrackingActiveAlways
+                   | NSTrackingInVisibleRect
+               owner:self
+            userInfo:nil]];
+}
+
+- (void)cursorUpdate:(NSEvent *)event {
+    (void) event;
+    [NSCursor.arrowCursor set];
+}
+
+// Drag from anywhere but the buttons, the title label included
+- (NSView *)hitTest:(NSPoint)point {
+    NSView *hit = [super hitTest:point];
+    return [hit isKindOfClass:NSButton.class] ? hit : (hit ? self : nil);
+}
+
+- (void)mouseDown:(NSEvent *)event {
+    (void) event;
+    _dragging = YES;
+    drag_start_mouse = [NSEvent mouseLocation];
+    drag_start_origin = self.window.parentWindow.frame.origin;
+}
+
+- (void)mouseUp:(NSEvent *)event {
+    (void) event;
+    _dragging = NO;
+}
+
+- (void)mouseDragged:(NSEvent *)event {
+    (void) event;
+    NSWindow *parent = self.window.parentWindow;
+    if (!parent) {
+        return;
+    }
+    // The bar is a child window, so it follows its parent
+    NSPoint mouse = [NSEvent mouseLocation];
+    [parent setFrameOrigin:NSMakePoint(
+        drag_start_origin.x + mouse.x - drag_start_mouse.x,
+        drag_start_origin.y + mouse.y - drag_start_mouse.y)];
+}
+
+@end
+
+// Resizing from the visible outline. macOS puts the resize zones of a
+// borderless window on its rectangle, a few points outside it, so with the
+// rounded corners they sit away from what you see. The ring is a child window
+// around the mirror that takes the pointer only in a thin band hugging the
+// rounded outline, shows the matching resize cursor and resizes the mirror
+// keeping the phone's aspect ratio.
+#define SC_RING_BAND 6.0
+#define SC_RING_MIN_HEIGHT 320.0
+
+@interface SCRingView : NSView
+@property(nonatomic, weak) NSWindow *mirror;
+@property(nonatomic) CGFloat radius;
+@property(nonatomic) CGFloat aspect;
+@end
+
+@implementation SCRingView {
+    NSInteger edge_x;
+    NSInteger edge_y;
+    BOOL dragging;
+    NSRect start_frame;
+    NSPoint start_mouse;
+}
+
+- (BOOL)acceptsFirstMouse:(NSEvent *)event {
+    (void) event;
+    return YES;
+}
+
+// The band between the mirror's outline and the same outline SC_RING_BAND out
+- (NSBezierPath *)ringPath {
+    NSRect inner = NSInsetRect(self.bounds, SC_RING_BAND, SC_RING_BAND);
+    NSBezierPath *path = [NSBezierPath
+        bezierPathWithRoundedRect:self.bounds
+                          xRadius:self.radius + SC_RING_BAND
+                          yRadius:self.radius + SC_RING_BAND];
+    [path appendBezierPath:[NSBezierPath bezierPathWithRoundedRect:inner
+                                                           xRadius:self.radius
+                                                           yRadius:self.radius]];
+    path.windingRule = NSWindingRuleEvenOdd;
+    return path;
+}
+
+- (void)drawRect:(NSRect)dirty {
+    (void) dirty;
+    // Nearly invisible, but not transparent: the window server passes clicks
+    // through fully transparent pixels
+    [[NSColor colorWithWhite:0 alpha:0.012] setFill];
+    [[self ringPath] fill];
+}
+
+- (NSView *)hitTest:(NSPoint)point {
+    NSPoint local = [self convertPoint:point fromView:self.superview];
+    return [[self ringPath] containsPoint:local] ? self : nil;
+}
+
+- (void)updateTrackingAreas {
+    for (NSTrackingArea *area in self.trackingAreas) {
+        [self removeTrackingArea:area];
+    }
+    [self addTrackingArea:[[NSTrackingArea alloc]
+        initWithRect:self.bounds
+             options:NSTrackingMouseMoved | NSTrackingMouseEnteredAndExited
+                   | NSTrackingActiveAlways | NSTrackingCursorUpdate
+               owner:self
+            userInfo:nil]];
+}
+
+- (void)edgeAt:(NSPoint)point x:(NSInteger *)x y:(NSInteger *)y {
+    NSRect inner = NSInsetRect(self.bounds, SC_RING_BAND, SC_RING_BAND);
+    // Within the corner's curve both sides move
+    CGFloat reach = MAX(self.radius, 12);
+    NSInteger ex = point.x < NSMinX(inner) + reach
+                 ? -1 : (point.x > NSMaxX(inner) - reach ? 1 : 0);
+    NSInteger ey = point.y < NSMinY(inner) + reach
+                 ? -1 : (point.y > NSMaxY(inner) - reach ? 1 : 0);
+    if (!ex || !ey) {
+        // Along a side, the side the point is outside of
+        ex = point.x < NSMinX(inner) ? -1 : (point.x > NSMaxX(inner) ? 1 : 0);
+        ey = ex ? 0 : (point.y < NSMinY(inner) ? -1 : 1);
+    }
+    *x = ex;
+    *y = ey;
+}
+
+- (NSCursor *)cursorForX:(NSInteger)x y:(NSInteger)y {
+    if (@available(macOS 15.0, *)) {
+        NSCursorFrameResizePosition position =
+              x < 0 && y > 0 ? NSCursorFrameResizePositionTopLeft
+            : x > 0 && y > 0 ? NSCursorFrameResizePositionTopRight
+            : x < 0 && y < 0 ? NSCursorFrameResizePositionBottomLeft
+            : x > 0 && y < 0 ? NSCursorFrameResizePositionBottomRight
+            : x < 0 ? NSCursorFrameResizePositionLeft
+            : x > 0 ? NSCursorFrameResizePositionRight
+            : y > 0 ? NSCursorFrameResizePositionTop
+            : NSCursorFrameResizePositionBottom;
+        return [NSCursor frameResizeCursorFromPosition:position
+                                          inDirections:NSCursorFrameResizeDirectionsAll];
+    }
+    return y ? NSCursor.resizeUpDownCursor : NSCursor.resizeLeftRightCursor;
+}
+
+- (void)mouseMoved:(NSEvent *)event {
+    NSPoint point = [self convertPoint:event.locationInWindow fromView:nil];
+    if ([[self ringPath] containsPoint:point]) {
+        NSInteger x, y;
+        [self edgeAt:point x:&x y:&y];
+        [[self cursorForX:x y:y] set];
+    }
+}
+
+- (void)cursorUpdate:(NSEvent *)event {
+    [self mouseMoved:event];
+}
+
+- (void)mouseExited:(NSEvent *)event {
+    (void) event;
+    if (!dragging) {
+        [NSCursor.arrowCursor set];
+    }
+}
+
+- (NSPoint)screenPoint:(NSEvent *)event {
+    return self.window ? [self.window convertPointToScreen:event.locationInWindow]
+                       : [NSEvent mouseLocation];
+}
+
+- (void)mouseDown:(NSEvent *)event {
+    NSWindow *mirror = self.mirror;
+    if (!mirror) {
+        return;
+    }
+    [self edgeAt:[self convertPoint:event.locationInWindow fromView:nil]
+               x:&edge_x y:&edge_y];
+    dragging = YES;
+    start_frame = mirror.frame;
+    start_mouse = [self screenPoint:event];
+}
+
+- (void)mouseDragged:(NSEvent *)event {
+    NSWindow *mirror = self.mirror;
+    if (!mirror || !dragging || start_frame.size.height <= 0) {
+        return;
+    }
+    [[self cursorForX:edge_x y:edge_y] set];
+    CGFloat aspect = self.aspect > 0
+        ? self.aspect : start_frame.size.width / start_frame.size.height;
+    NSPoint mouse = [self screenPoint:event];
+    CGFloat dx = (mouse.x - start_mouse.x) * edge_x;
+    CGFloat dy = (mouse.y - start_mouse.y) * edge_y;
+    // The side the pointer pulls furthest sets the size; the other follows
+    // the aspect
+    CGFloat height = start_frame.size.height + MAX(dy, dx / aspect);
+    if (!edge_x) {
+        height = start_frame.size.height + dy;
+    }
+    if (!edge_y) {
+        height = start_frame.size.height + dx / aspect;
+    }
+    CGFloat screen = mirror.screen ? mirror.screen.visibleFrame.size.height
+                                   : CGFLOAT_MAX;
+    height = round(MIN(MAX(height, SC_RING_MIN_HEIGHT), screen));
+    CGFloat width = round(height * aspect);
+    // The opposite sides stay put; a side drag keeps the top, a top or bottom
+    // drag keeps the left
+    CGFloat x = edge_x < 0 ? NSMaxX(start_frame) - width : NSMinX(start_frame);
+    CGFloat y = edge_y < 0 ? NSMaxY(start_frame) - height
+              : (edge_y > 0 ? NSMinY(start_frame)
+                            : NSMaxY(start_frame) - height);
+    [mirror setFrame:NSMakeRect(x, y, width, height) display:YES];
+}
+
+- (void)mouseUp:(NSEvent *)event {
+    (void) event;
+    dragging = NO;
+}
+
+@end
+
+// A round pointer like iOS's own over the phone, darker while it touches
+static SDL_Cursor *
+sc_touch_cursor(CGFloat fill) {
+    SDL_Surface *images[2] = {NULL, NULL};
+    for (int scale = 1; scale <= 2; ++scale) {
+        int size = 18 * scale;
+        SDL_Surface *surface = SDL_CreateSurface(size, size, SDL_PIXELFORMAT_ARGB8888);
+        if (!surface) {
+            break;
+        }
+        CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
+        CGContextRef ctx = CGBitmapContextCreate(surface->pixels, size, size, 8,
+            surface->pitch, space,
+            kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little);
+        CGColorSpaceRelease(space);
+        memset(surface->pixels, 0, surface->pitch * size);
+        CGContextScaleCTM(ctx, scale, scale);
+        CGContextSetRGBFillColor(ctx, 0.5, 0.5, 0.5, fill);
+        CGContextFillEllipseInRect(ctx, CGRectMake(2, 2, 14, 14));
+        CGContextSetRGBStrokeColor(ctx, 1, 1, 1, 0.9);
+        CGContextSetLineWidth(ctx, 1.5);
+        CGContextStrokeEllipseInRect(ctx, CGRectMake(2, 2, 14, 14));
+        // A faint dark rim keeps it visible on white
+        CGContextSetRGBStrokeColor(ctx, 0, 0, 0, 0.22);
+        CGContextSetLineWidth(ctx, 1);
+        CGContextStrokeEllipseInRect(ctx, CGRectMake(1, 1, 16, 16));
+        CGContextRelease(ctx);
+        images[scale - 1] = surface;
+    }
+    if (!images[0]) {
+        return NULL;
+    }
+    if (images[1]) {
+        SDL_AddSurfaceAlternateImage(images[0], images[1]);
+        SDL_DestroySurface(images[1]);
+    }
+    SDL_Cursor *cursor = SDL_CreateColorCursor(images[0], 9, 9);
+    SDL_DestroySurface(images[0]);
+    return cursor;
+}
+
+@interface SCWindowStyler : NSObject
+@end
+
+@implementation SCWindowStyler {
+    SDL_Window *sdl_window;
+    NSWindow *window;
+    NSPanel *bar;
+    NSVisualEffectView *bar_material;
+    NSArray<NSButton *> *lights;
+    NSTextField *title_label;
+    NSTimer *timer;
+    id mouse_monitor;
+    BOOL bar_shown;
+    // The bar shows for a moment when the window opens, so it can be found
+    NSDate *intro_until;
+    // Buttons pressed with Cmd, kept from the device until released
+    NSUInteger cmd_buttons;
+    NSPanel *ring;
+    SCRingView *ring_view;
+    CGFloat aspect;
+    SDL_Cursor *touch_cursor;
+    SDL_Cursor *pressed_cursor;
+    SDL_Cursor *move_cursor;
+}
+
+- (instancetype)initWithSDLWindow:(SDL_Window *)sdl
+                         nsWindow:(NSWindow *)ns
+                            title:(NSString *)title {
+    self = [super init];
+    if (!self) {
+        return nil;
+    }
+
+    sdl_window = sdl;
+    window = ns;
+    bar = [self makeBarWithTitle:title];
+    [self makeRing];
+    // AWB_CURSOR=system keeps macOS's own pointer over the phone
+    const char *cursor_env = getenv("AWB_CURSOR");
+    BOOL touch = !cursor_env || strcmp(cursor_env, "system");
+    touch_cursor = touch ? sc_touch_cursor(0.42) : SDL_GetDefaultCursor();
+    pressed_cursor = touch ? sc_touch_cursor(0.62) : SDL_GetDefaultCursor();
+    move_cursor = SDL_CreateSystemCursor(SDL_SYSTEM_CURSOR_MOVE);
+    if (touch_cursor) {
+        SDL_SetCursor(touch_cursor);
+    }
+
+    [self applyStyle];
+
+    NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+    NSArray<NSNotificationName> *restyle = @[
+        NSWindowDidResizeNotification,
+        NSWindowDidExitFullScreenNotification,
+        NSWindowDidEnterFullScreenNotification,
+        NSWindowDidDeminiaturizeNotification,
+    ];
+    for (NSNotificationName name in restyle) {
+        [center addObserver:self
+                   selector:@selector(windowChanged:)
+                       name:name
+                     object:window];
+    }
+
+    for (NSNotificationName name in @[NSWindowDidBecomeKeyNotification,
+                                       NSWindowDidResignKeyNotification]) {
+        [center addObserver:self
+                   selector:@selector(keyChanged:)
+                       name:name
+                     object:window];
+    }
+
+    // Poll the pointer rather than track areas on SDL's view, which SDL owns.
+    // It runs in the common modes so it keeps firing during a drag.
+    timer = [NSTimer timerWithTimeInterval:SC_HOVER_POLL_INTERVAL
+                                    target:self
+                                  selector:@selector(tick:)
+                                  userInfo:nil
+                                   repeats:YES];
+    [[NSRunLoop mainRunLoop] addTimer:timer forMode:NSRunLoopCommonModes];
+
+    [self installCommandDrag];
+
+    return self;
+}
+
+// QuickTime-style title bar: an overlay across the top of the screen, square
+// at the bottom, its top corners following the window's rounding
+- (NSPanel *)makeBarWithTitle:(NSString *)title {
+    NSRect frame = NSMakeRect(0, 0, 200, SC_TITLE_BAR_HEIGHT);
+    NSPanel *panel = [[NSPanel alloc]
+        initWithContentRect:frame
+                  styleMask:NSWindowStyleMaskBorderless
+                            | NSWindowStyleMaskNonactivatingPanel
+                    backing:NSBackingStoreBuffered
+                      defer:YES];
+    panel.releasedWhenClosed = NO;
+    panel.opaque = NO;
+    panel.backgroundColor = NSColor.clearColor;
+    panel.hasShadow = NO;
+    panel.hidesOnDeactivate = NO;
+    panel.becomesKeyOnlyIfNeeded = YES;
+    panel.collectionBehavior = NSWindowCollectionBehaviorTransient
+                             | NSWindowCollectionBehaviorIgnoresCycle;
+    panel.alphaValue = 0;
+    panel.accessibilityElement = NO;
+
+    SCTitleBarView *view = [[SCTitleBarView alloc] initWithFrame:frame];
+    view.wantsLayer = YES;
+    view.layer.masksToBounds = YES;
+    panel.contentView = view;
+
+    // As tall as the window, so its rounded top matches the window's corners
+    // exactly; the bar shows only its top strip
+    bar_material = [[NSVisualEffectView alloc] initWithFrame:frame];
+    bar_material.material = NSVisualEffectMaterialHUDWindow;
+    bar_material.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+    bar_material.state = NSVisualEffectStateActive;
+    bar_material.wantsLayer = YES;
+    bar_material.layer.cornerCurve = kCACornerCurveContinuous;
+    bar_material.layer.masksToBounds = YES;
+    [view addSubview:bar_material];
+
+    // AppKit's standard buttons stay gray outside a real title bar, so draw
+    // the traffic lights here
+    SEL actions[] = {
+        @selector(closeClicked:),
+        @selector(minimizeClicked:),
+        @selector(zoomClicked:),
+    };
+    NSMutableArray<NSButton *> *buttons = [NSMutableArray array];
+    for (size_t i = 0; i < 3; ++i) {
+        NSButton *button = [[NSButton alloc] initWithFrame:NSMakeRect(
+            0, (SC_TITLE_BAR_HEIGHT - SC_LIGHT_SIZE) / 2,
+            SC_LIGHT_SIZE, SC_LIGHT_SIZE)];
+        button.bordered = NO;
+        button.title = @"";
+        button.tag = i;
+        button.wantsLayer = YES;
+        button.layer.cornerRadius = SC_LIGHT_SIZE / 2;
+        button.target = self;
+        button.action = actions[i];
+        [view addSubview:button];
+        [buttons addObject:button];
+    }
+    lights = buttons;
+
+    NSTextField *label = [NSTextField labelWithString:title];
+    label.font = [NSFont titleBarFontOfSize:0];
+    label.textColor = NSColor.secondaryLabelColor;
+    label.alignment = NSTextAlignmentCenter;
+    label.lineBreakMode = NSLineBreakByTruncatingTail;
+    [view addSubview:label];
+    title_label = label;
+
+    return panel;
+}
+
+- (CGFloat)cornerRadius {
+    return [self isFullscreen]
+        ? 0 : round(window.frame.size.width * SC_CORNER_RADIUS_RATIO);
+}
+
+// Fit the bar to the window's current width and corners
+- (void)layoutBar {
+    NSRect parent = window.frame;
+    [bar setFrame:NSMakeRect(parent.origin.x,
+                             NSMaxY(parent) - SC_TITLE_BAR_HEIGHT,
+                             parent.size.width, SC_TITLE_BAR_HEIGHT)
+          display:NO];
+
+    CGFloat radius = [self cornerRadius];
+    bar_material.frame = NSMakeRect(0, SC_TITLE_BAR_HEIGHT - parent.size.height,
+                                    parent.size.width, parent.size.height);
+    bar_material.layer.cornerRadius = radius;
+
+    // Keep the lights clear of the rounded corner at the bar's mid-height
+    CGFloat mid = SC_TITLE_BAR_HEIGHT / 2;
+    CGFloat corner = radius > mid
+        ? radius - sqrt(radius * radius - (radius - mid) * (radius - mid)) : 0;
+    CGFloat x = MAX(SC_LIGHT_MARGIN, corner + SC_LIGHT_MARGIN);
+    for (NSButton *light in lights) {
+        [light setFrameOrigin:NSMakePoint(x, light.frame.origin.y)];
+        x += SC_LIGHT_SIZE + SC_LIGHT_SPACING;
+    }
+
+    NSTextField *label = title_label;
+    CGFloat height = label.intrinsicContentSize.height;
+    CGFloat inset = x + 4;
+    label.frame = NSMakeRect(inset, (SC_TITLE_BAR_HEIGHT - height) / 2,
+                             MAX(0, parent.size.width - 2 * inset), height);
+}
+
+// Cmd + drag anywhere moves the window. While Cmd is held, no mouse event
+// reaches SDL, so nothing goes to the device; scrcpy binds no mouse action
+// to Cmd (its mouse gestures use Ctrl and Shift).
+- (void)installCommandDrag {
+    NSEventMask mask = NSEventMaskLeftMouseDown | NSEventMaskLeftMouseDragged
+                     | NSEventMaskLeftMouseUp | NSEventMaskRightMouseDown
+                     | NSEventMaskRightMouseDragged | NSEventMaskRightMouseUp
+                     | NSEventMaskOtherMouseDown | NSEventMaskOtherMouseDragged
+                     | NSEventMaskOtherMouseUp | NSEventMaskScrollWheel
+                     | NSEventMaskMouseMoved | NSEventMaskFlagsChanged;
+    __weak SCWindowStyler *weak_self = self;
+    mouse_monitor = [NSEvent addLocalMonitorForEventsMatchingMask:mask
+                                                          handler:^NSEvent *(NSEvent *event) {
+        SCWindowStyler *strong_self = weak_self;
+        return strong_self ? [strong_self filterMouseEvent:event] : event;
+    }];
+}
+
+// The round touch pointer, darker while pressed, or the move cursor while
+// Cmd is held
+- (void)updateCursor:(NSEvent *)event {
+    BOOL cmd = (event.modifierFlags & NSEventModifierFlagCommand) != 0;
+    SDL_Cursor *cursor = cmd && ![self sdlHasButtonDown] ? move_cursor
+                       : [self sdlHasButtonDown] ? pressed_cursor : touch_cursor;
+    if (cursor && SDL_GetCursor() != cursor) {
+        SDL_SetCursor(cursor);
+    }
+}
+
+- (NSEvent *)filterMouseEvent:(NSEvent *)event {
+    NSEventType type = event.type;
+    if (type == NSEventTypeFlagsChanged) {
+        [self updateCursor:event];
+        return event;
+    }
+    BOOL down = type == NSEventTypeLeftMouseDown
+             || type == NSEventTypeRightMouseDown
+             || type == NSEventTypeOtherMouseDown;
+    BOOL up = type == NSEventTypeLeftMouseUp
+           || type == NSEventTypeRightMouseUp
+           || type == NSEventTypeOtherMouseUp;
+    NSUInteger button = down || up ? (NSUInteger) 1 << event.buttonNumber : 0;
+
+    // Forget buttons no longer held: the window drag may consume a mouse up,
+    // and a new press of the same button starts over
+    if (down) {
+        cmd_buttons &= ~button;
+    }
+    cmd_buttons &= [NSEvent pressedMouseButtons] | (up ? button : 0);
+
+    if (up && (cmd_buttons & button)) {
+        // The release of a press that never reached the device
+        cmd_buttons &= ~button;
+        return nil;
+    }
+
+    if (event.window != window) {
+        return event;
+    }
+    // SDL sees the press after this monitor, so the pressed look follows it
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [self updateCursor:[NSApp currentEvent] ?: event];
+    });
+
+    BOOL cmd = (event.modifierFlags & NSEventModifierFlagCommand)
+            && ![self sdlHasButtonDown];
+    if (down && cmd) {
+        cmd_buttons |= button;
+        if (type == NSEventTypeLeftMouseDown) {
+            [window performWindowDragWithEvent:event];
+        }
+        return nil;
+    }
+
+    // Swallow the rest of a Cmd gesture, even once Cmd is released
+    return cmd_buttons || cmd ? nil : event;
+}
+
+// A gesture that started without Cmd keeps going to the device, so the phone
+// never sees a touch down without its up
+- (BOOL)sdlHasButtonDown {
+    return SDL_GetMouseState(NULL, NULL) != 0;
+}
+
+- (BOOL)isFullscreen {
+    return (window.styleMask & NSWindowStyleMaskFullScreen) != 0;
+}
+
+- (void)makeRing {
+    ring = [[NSPanel alloc] initWithContentRect:NSZeroRect
+                                      styleMask:NSWindowStyleMaskBorderless
+                                              | NSWindowStyleMaskNonactivatingPanel
+                                        backing:NSBackingStoreBuffered
+                                          defer:YES];
+    ring.opaque = NO;
+    ring.backgroundColor = NSColor.clearColor;
+    ring.hasShadow = NO;
+    ring.hidesOnDeactivate = NO;
+    ring.becomesKeyOnlyIfNeeded = YES;
+    ring.releasedWhenClosed = NO;
+    ring.collectionBehavior = NSWindowCollectionBehaviorTransient
+                            | NSWindowCollectionBehaviorIgnoresCycle;
+    ring.acceptsMouseMovedEvents = YES;
+    // Only the mirror is a window to window managers
+    ring.accessibilityElement = NO;
+    ring_view = [[SCRingView alloc] initWithFrame:NSZeroRect];
+    ring_view.mirror = window;
+    ring.contentView = ring_view;
+}
+
+// Fits the ring around the mirror; hidden while full screen or minimized
+- (void)updateRing {
+    BOOL shown = window.visible && !window.miniaturized && ![self isFullscreen];
+    if (!shown) {
+        if (ring.parentWindow) {
+            [window removeChildWindow:ring];
+        }
+        [ring orderOut:nil];
+        return;
+    }
+    ring_view.radius = [self cornerRadius];
+    ring_view.aspect = aspect;
+    [ring setFrame:NSInsetRect(window.frame, -SC_RING_BAND, -SC_RING_BAND)
+           display:NO];
+    ring_view.needsDisplay = YES;
+    if (!ring.parentWindow) {
+        [window addChildWindow:ring ordered:NSWindowBelow];
+    }
+    ring.level = window.level;
+}
+
+- (void)setAspect:(CGFloat)ratio {
+    aspect = ratio;
+    // After scrcpy's own resize, which follows this call
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [self fitAspect];
+    });
+}
+
+// The window takes the phone's exact shape, keeping its height and center,
+// so no letterbox shows and its edges are the phone's
+- (void)fitAspect {
+    if (aspect <= 0 || [self isFullscreen]) {
+        return;
+    }
+    NSRect frame = window.frame;
+    CGFloat width = round(frame.size.height * aspect);
+    if (fabs(width - frame.size.width) < 1) {
+        return;
+    }
+    frame.origin.x += (frame.size.width - width) / 2;
+    frame.size.width = width;
+    [window setFrame:frame display:YES];
+}
+
+- (void)applyStyle {
+    // The ring resizes; macOS's own zones sit off the rounded outline
+    if (![self isFullscreen] && (window.styleMask & NSWindowStyleMaskResizable)) {
+        window.styleMask &= ~NSWindowStyleMaskResizable;
+    }
+    window.opaque = NO;
+    window.backgroundColor = NSColor.clearColor;
+    window.hasShadow = YES;
+
+    NSView *content = window.contentView;
+    content.wantsLayer = YES;
+    content.layer.cornerRadius = [self cornerRadius];
+    content.layer.cornerCurve = kCACornerCurveContinuous;
+    content.layer.masksToBounds = YES;
+
+    // The shadow follows the window's alpha, recompute it for the new corners
+    [window invalidateShadow];
+    [self updateRing];
+}
+
+- (void)windowChanged:(NSNotification *)notification {
+    (void) notification;
+    [self fitAspect];
+    [self applyStyle];
+    if (bar_shown) {
+        [self layoutBar];
+    }
+}
+
+- (void)keyChanged:(NSNotification *)notification {
+    (void) notification;
+    [self updateLights];
+}
+
+// Colored while the mirror window is active, gray otherwise, like AppKit's
+- (void)updateLights {
+    NSColor *colors[] = {
+        [NSColor colorWithSRGBRed:1.00 green:0.37 blue:0.34 alpha:1],
+        [NSColor colorWithSRGBRed:1.00 green:0.74 blue:0.18 alpha:1],
+        [NSColor colorWithSRGBRed:0.16 green:0.78 blue:0.25 alpha:1],
+    };
+    BOOL active = window.isKeyWindow;
+    for (NSButton *light in lights) {
+        NSColor *color = active ? colors[light.tag]
+                                : [NSColor colorWithWhite:0.5 alpha:0.5];
+        light.layer.backgroundColor = color.CGColor;
+    }
+}
+
+- (void)tick:(NSTimer *)t {
+    (void) t;
+
+    if (window.opaque) {
+        // SDL resets the window background on some transitions
+        [self applyStyle];
+    }
+
+    BOOL can_show = window.visible && !window.miniaturized
+                 && ![self isFullscreen];
+    BOOL hovered = NO;
+    if (can_show) {
+        NSPoint mouse = [NSEvent mouseLocation];
+        // Over the mirror only where no other window covers it
+        NSInteger top = [NSWindow windowNumberAtPoint:mouse
+                          belowWindowWithWindowNumber:0];
+        BOOL on_top = top == window.windowNumber
+                   || (bar_shown && top == bar.windowNumber);
+        // Keep the bar while it drags the window
+        BOOL dragging = bar_shown && ([NSEvent pressedMouseButtons] & 1)
+                     && ((SCTitleBarView *) bar.contentView).dragging;
+        // Only while Cmd is held, so the top edge stays the phone's for
+        // pull-downs
+        BOOL cmd = ([NSEvent modifierFlags] & NSEventModifierFlagCommand) != 0;
+        // scrcpy shows the window a moment after styling it
+        if (!intro_until) {
+            intro_until = [NSDate dateWithTimeIntervalSinceNow:1.5];
+        }
+        BOOL intro = [intro_until timeIntervalSinceNow] > 0;
+        hovered = (on_top && cmd && NSPointInRect(mouse, window.frame))
+               || dragging || intro;
+    }
+
+    if (bar_shown && bar.level != window.level) {
+        bar.level = window.level;
+    }
+
+    if (hovered && !bar_shown) {
+        [self showBar];
+    } else if (!hovered && bar_shown) {
+        [self hideBar];
+    }
+}
+
+- (void)showBar {
+    bar_shown = YES;
+    [self layoutBar];
+    bar.level = window.level;
+    bar.ignoresMouseEvents = NO;
+    [self updateLights];
+    if (!bar.parentWindow) {
+        [window addChildWindow:bar ordered:NSWindowAbove];
+    }
+    [bar orderFront:nil];
+    [NSAnimationContext runAnimationGroup:^(NSAnimationContext *context) {
+        context.duration = SC_FADE_DURATION;
+        bar.animator.alphaValue = 1;
+    } completionHandler:nil];
+}
+
+- (void)hideBar {
+    bar_shown = NO;
+    // Let clicks through to the device while the bar fades out
+    bar.ignoresMouseEvents = YES;
+    NSPanel *panel = bar;
+    NSWindow *parent = window;
+    [NSAnimationContext runAnimationGroup:^(NSAnimationContext *context) {
+        context.duration = SC_FADE_DURATION;
+        panel.animator.alphaValue = 0;
+    } completionHandler:^{
+        if (self->bar_shown) {
+            return;
+        }
+        // Detach the hidden bar so it takes no clicks and window managers
+        // only ever see the mirror window
+        [parent removeChildWindow:panel];
+        [panel orderOut:nil];
+    }];
+}
+
+- (void)closeClicked:(id)sender {
+    (void) sender;
+    SDL_Event event = {.type = SDL_EVENT_QUIT};
+    SDL_PushEvent(&event);
+}
+
+- (void)minimizeClicked:(id)sender {
+    (void) sender;
+    SDL_MinimizeWindow(sdl_window);
+}
+
+- (void)zoomClicked:(id)sender {
+    (void) sender;
+    // Full screen needs a resizable window; applyStyle drops it again after
+    window.styleMask |= NSWindowStyleMaskResizable;
+    bool fullscreen = SDL_GetWindowFlags(sdl_window) & SDL_WINDOW_FULLSCREEN;
+    SDL_SetWindowFullscreen(sdl_window, !fullscreen);
+}
+
+@end
+
+// Lives as long as the process: scrcpy has a single window
+static SCWindowStyler *styler;
+
+void
+sc_macos_window_set_aspect(SDL_Window *window, int width, int height) {
+    (void) window;
+    if (styler && width > 0 && height > 0) {
+        [styler setAspect:(CGFloat) width / height];
+    }
+}
+
+void
+sc_macos_window_init(SDL_Window *window, const char *title) {
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    NSWindow *ns_window = (__bridge NSWindow *) SDL_GetPointerProperty(
+        props, SDL_PROP_WINDOW_COCOA_WINDOW_POINTER, NULL);
+    if (!ns_window) {
+        LOGW("Could not get the Cocoa window, keeping the default style");
+        return;
+    }
+
+    @autoreleasepool {
+        styler = [[SCWindowStyler alloc]
+            initWithSDLWindow:window
+                     nsWindow:ns_window
+                        title:[NSString stringWithUTF8String:title] ?: @""];
+    }
+}
